# ─── PUBLIC (safe to expose in browser) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://jdcdevelopers.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/jdcdevelopers

# ─── SERVER ONLY (never expose to browser) ────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_your-resend-api-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Comma-separated list of admin emails (magic link access to /admin)
ADMIN_EMAILS=tomi@jdcdevelopers.com,carlos@jdcdevelopers.com,juanb@jdcdevelopers.com

# Comma-separated list of partner emails that receive lead notifications
SOCIOS_EMAILS=tomi@jdcdevelopers.com,carlos@jdcdevelopers.com,juanb@jdcdevelopers.com

# Calendly URL for meeting scheduling
CALENDLY_URL=https://calendly.com/jdcdevelopers

# Random 32+ character string for hashing IPs in logs (generate with: openssl rand -hex 32)
IP_HASH_SALT=generate-a-random-32-char-string-here
